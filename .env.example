# Required
OPENROUTER_API_KEY=

# Models — change these to swap providers/models, no code edits needed
IMAGE_MODEL=google/gemini-nano-banana-2.1
TEXT_MODEL=deepseek/deepseek-v4.1-flash

# Image render settings: 1K | 2K | 4K — only used by the 'photo' layout
IMAGE_RESOLUTION=2K

# Output and safety
OUTPUT_DIR=out
MAX_COST_USD=5
CONCURRENCY=3

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TITLE=ads-generator
# OPENROUTER_REFERER=https://github.com/darideveloper/ads-generator
